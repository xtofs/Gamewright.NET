<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by the [JSImport]/[JSExport] source generator -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Gamewright.Primitives" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Gamewright.Primitives/Gamewright.Primitives.csproj" />
    <ProjectReference Include="../Gamewright.SquareGrid/Gamewright.SquareGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.12" />
  </ItemGroup>

</Project>
