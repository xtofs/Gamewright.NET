@page "/"
@using Gamewright
@implements IDisposable

<PageTitle>Chess Canvas</PageTitle>

@* Blazor renders this once; after that the JS frame loop drives everything. *@
<canvas id="surface"></canvas>

@code {
    readonly Renderer _renderer = new Renderer(new ChessApp());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _renderer.StartAsync("surface");
    }

    public void Dispose() => _renderer.Stop();
}
