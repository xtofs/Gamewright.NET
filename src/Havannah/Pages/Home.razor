@page "/"
@using Gamewright
@implements IDisposable

<PageTitle>Havannah Canvas</PageTitle>

<aside class="left">
  <h1>Havannah</h1>
  <p>@_app.StatusText</p>
  <button type="button" @onclick="StartNewGame">New game</button>
</aside>

@* Blazor renders this once; after that the JS frame loop drives everything. *@
<canvas id="surface" tabindex="0"></canvas>

@code {
  readonly HavannahApp _app = new();
  readonly Renderer _renderer;

  public Home()
  {
    _renderer = new Renderer(_app);
    _app.UiStateChanged += OnUiStateChanged;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
      await _renderer.StartAsync("surface");
  }

  void StartNewGame() => _app.StartNewGame();

  void OnUiStateChanged() => _ = InvokeAsync(StateHasChanged);

  public void Dispose()
  {
    _app.UiStateChanged -= OnUiStateChanged;
    _renderer.Stop();
  }
}
